# /etc/broiestmemes/env  — root-owned, chmod 640, referenced by the systemd unit.
#
# Note there is no GCS credential here. The site reads the bucket over anonymous
# public HTTPS; only the pipeline needs a key, and the pipeline runs in CI.

NEXT_PUBLIC_ASSET_BASE=https://storage.googleapis.com/broiestbot
NEXT_PUBLIC_SITE_URL=https://broiestmemes.com
REVALIDATE_SECRET=generate-with-openssl-rand-hex-32
