# /etc/caddy/Caddyfile
#
# Automatic HTTPS via Let's Encrypt — no certbot, no renewal timer.
#
# ORDER MATTERS when putting Cloudflare in front: bring this up with DNS
# GREY-clouded so the ACME HTTP-01 challenge reaches the origin directly and a
# certificate is issued. Only then orange-cloud the records and set Cloudflare's
# SSL mode to Full (strict). Doing it the other way round deadlocks on the
# challenge redirect.

broiestmemes.com, www.broiestmemes.com {
	encode zstd gzip

	# Next emits content-hashed filenames under this path, so a one-year
	# immutable TTL is safe and takes static assets off the Node process.
	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy 127.0.0.1:3000

	log {
		output file /var/log/broiestmemes/info.log
		format json
	}
}
