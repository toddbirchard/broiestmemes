# Where derivatives and the manifest are served from. Swap this one value to move
# assets behind a Cloudflare-proxied subdomain (cdn.broiestmemes.com) or to R2.
NEXT_PUBLIC_ASSET_BASE=https://storage.googleapis.com/broiestbot

# Canonical origin. Used for metadataBase, absolute OG URLs, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://broiestmemes.com

# Bearer token the pipeline presents to POST /api/revalidate.
REVALIDATE_SECRET=change-me

# Pipeline only (never needed by the web app). Path to the GCS service-account key.
GOOGLE_APPLICATION_CREDENTIALS=./gcloud.json
